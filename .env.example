# Copy to .env for local overrides. Never commit .env. All values below are dummies.
# docker compose already sets DATABASE_URL, REDIS_URL and EMAIL_URL for local work.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-local-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

DATABASE_URL=postgres://emr:emr@localhost:5432/emr
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://localhost:6379/0

EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=no-reply@example.com

# Object storage (private bucket, signed URLs only)
S3_ENDPOINT_URL=https://example-account.r2.cloudflarestorage.com
S3_BUCKET_NAME=emr-files-local
S3_ACCESS_KEY_ID=dummy-access-key
S3_SECRET_ACCESS_KEY=dummy-secret-key
S3_REGION=auto
S3_SIGNED_URL_SECONDS=300

# Field-level encryption for sensitive columns (used from the patients step onward)
FIELD_ENCRYPTION_KEY=dummy-field-encryption-key

# Production only
SECURE_HSTS_SECONDS=31536000
WEB_CONCURRENCY=3
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# Host ports for docker compose
WEB_PORT=8000
MAILPIT_PORT=8026

# Accounts and access control
API_TOKEN_TTL_MINUTES=720
AUTH_THROTTLE_RATE=10/min
BILLING_REMINDER_INTERVAL_HOURS=72
BILLING_REMINDER_MAX=3
PORTAL_URL=http://localhost:8080
OTP_EMAIL_TOKEN_VALIDITY=300
OTP_EMAIL_COOLDOWN_DURATION=30
MFA_REQUIRED_ROLES=tenant_admin,doctor,nurse,pharmacist,lab_technician,front_desk,billing_officer,finance,hr,compliance_officer
BREAK_GLASS_ROLES=doctor,nurse
BREAK_GLASS_MINUTES=60
PASSWORD_RESET_URL=http://localhost:3000/reset-password?uid={uid}&token={token}
AUDIT_TRUST_X_FORWARDED_FOR=false

# Patients
MRN_TIME_ZONE=Africa/Lagos
DEFAULT_PHONE_COUNTRY_CODE=234
PATIENT_DECEASED_ROLES=doctor
PATIENT_ATTACHMENT_MAX_BYTES=20971520

# Staff, scheduling and notifications
LICENCE_EXPIRY_WARNING_DAYS=60
INPATIENT_TIME_ZONE=Africa/Lagos
PORTAL_BOOKING_DAYS=14
PORTAL_MAX_UPCOMING_VISITS=3
PORTAL_CANCEL_MIN_HOURS=2
APPOINTMENT_SLOT_MINUTES=15
APPOINTMENT_REMINDER_OFFSETS_HOURS=24,2
ICS_UID_DOMAIN=emr.local
CELERY_TIMEZONE=Africa/Lagos

# Pharmacy. Generate a signing key with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
PRESCRIPTION_SIGNING_KEY=
PRESCRIPTION_RETIRED_PUBLIC_KEYS=

# Rate limits and proxies
ANON_THROTTLE_RATE=60/min
USER_THROTTLE_RATE=600/min
NUM_PROXIES=0

# Payments (Paystack). Use the TEST secret key (sk_test_...) until go-live; never commit a real key.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=15
PAYMENT_INTENT_MINUTES=30
