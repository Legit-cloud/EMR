# Copy to .env for local overrides. Never commit .env. All values below are dummies.
# docker compose already sets DATABASE_URL, REDIS_URL and EMAIL_URL for local work.

DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-local-only
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

DATABASE_URL=postgres://emr:emr@localhost:5432/emr
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0

EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=no-reply@example.com

# Object storage (private bucket, signed URLs only)
S3_ENDPOINT_URL=https://example-account.r2.cloudflarestorage.com
S3_BUCKET_NAME=emr-files-local
S3_ACCESS_KEY_ID=dummy-access-key
S3_SECRET_ACCESS_KEY=dummy-secret-key
S3_REGION=auto
S3_SIGNED_URL_SECONDS=300

# Field-level encryption for sensitive columns (used from the patients step onward)
FIELD_ENCRYPTION_KEY=dummy-field-encryption-key

# Production only
SECURE_HSTS_SECONDS=31536000
WEB_CONCURRENCY=3
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

# SMS provider (pending decision, CLAUDE.md Section 12)
SMS_PROVIDER=console
SMS_API_KEY=dummy-sms-key
SMS_SENDER_ID=EMR

# Host ports for docker compose
WEB_PORT=8000
MAILPIT_PORT=8026
